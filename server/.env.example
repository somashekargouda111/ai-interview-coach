NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/interview_coach

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=7d

# Get a key at https://aistudio.google.com/apikey  (never commit the real value)
GEMINI_API_KEY=your-gemini-api-key
# Check Google's docs for the current Flash model name; change here, no code edits needed
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=45000

CLIENT_ORIGIN=http://localhost:5173
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
